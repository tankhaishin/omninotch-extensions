{
  "v": 2,
  "id": "com.mactoro.social",
  "name": "Social",
  "description": "Search the social networks and forums.",
  "category": "Communication",
  "author": "Mactoro",
  "icon": "sf:bubble.left.and.bubble.right",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-reddit",
      "title": "Search Reddit",
      "mode": "run",
      "url": "https://www.reddit.com/search/?q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "open-a-subreddit",
      "title": "Open a Subreddit",
      "mode": "run",
      "url": "https://www.reddit.com/r/{query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-x",
