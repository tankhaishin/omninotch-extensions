#!/usr/bin/osascript -l JavaScript
// Directions: an OmniNotch extension (FORMATS.md v2). The command bar runs this with OMNINOTCH_COMMAND set and draws the
// screen it prints. Plain JavaScript for Automation: nothing to install.
ObjC.import("Foundation"); ObjC.import("AppKit")
const ENV = $.NSProcessInfo.processInfo.environment
const env = (k) => { const v = ENV.objectForKey(k); return v.isNil() ? "" : v.js }
const SA = Application.currentApplication(); SA.includeStandardAdditions = true
const sh = (cmd) => { try { return SA.doShellScript("export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; " + cmd).replace(/\r/g, "\n") } catch (e) { return null } }
const q = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'"
const out = (o) => JSON.stringify(o)
const home = env("HOME")
const tilde = (p) => p.startsWith(home) ? "~" + p.slice(home.length) : p
function run() {
  if (env("OMNINOTCH_ACTION") === "go") {
    const f = JSON.parse(env("OMNINOTCH_FORM") || "{}"), flag = { Driving: "d", Walking: "w", Transit: "r", Cycling: "c" }[f.by] || "d"
    sh(`open ${q("maps://?daddr=" + encodeURIComponent(f.to || "") + (f.from ? "&saddr=" + encodeURIComponent(f.from) : "") + "&dirflg=" + flag)}`)
    return out({ close: true })
  }
  return out({ view: "form", title: "Directions", fields: [
      { id: "to", type: "text", title: "To", required: true }, { id: "from", type: "text", title: "From", placeholder: "Current location" },
      { id: "by", type: "dropdown", title: "By", options: ["Driving", "Walking", "Transit", "Cycling"] }],
    submit: { title: "Open in Maps", run: "go" } })
}
