{
  "v": 2,
  "id": "com.mactoro.design",
  "name": "Design Inspiration",
  "description": "Photos, icons, fonts and inspiration.",
  "category": "Images",
  "author": "Mactoro",
  "icon": "sf:paintpalette",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-unsplash",
      "title": "Search Unsplash",
      "mode": "run",
      "url": "https://unsplash.com/s/photos/{query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
