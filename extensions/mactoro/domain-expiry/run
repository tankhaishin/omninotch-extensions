#!/bin/zsh
# Domain Expiry: the registry's expiry date from whois. Amber when close, red under 7 days.
js() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; print -rn -- "\"$s\""; }   # a JSON string
warn=${OMNINOTCH_SETTING_DAYS:-30}; now=$(date +%s); out=()
for d in ${(s:,:)OMNINOTCH_SETTING_DOMAINS// /}; do
  d=${${d#*://}%%/*}
  date_s=$(whois $d 2>/dev/null | grep -iE 'Registry Expiry Date|Expiration Date|Expiry Date|paid-till|expires' | head -1 | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
  [[ -z $date_s ]] && { print -u2 "No expiry date in whois for $d"; continue }
  left=$(( ($(date -j -f %Y-%m-%d "$date_s" +%s) - now) / 86400 ))
  (( left > warn )) && continue
  extra=$( (( left < 7 )) && print ',"tint":"alert","priority":"high"' || print ',"tint":"rising"' )
  out+=("{\"v\":1,\"id\":$(js "dom-${d//[^A-Za-z0-9.-]/-}"),\"title\":$(js "Renew $d"),\"subtitle\":\"Expires $date_s\",\"value\":\"${left}d\",\"icon\":\"sf:globe.badge.chevron.backward\"$extra,\"expires\":\"25h\"}")
done
print -r -- "[${(j:,:)out[1,5]}]"
