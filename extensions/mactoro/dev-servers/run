#!/bin/zsh
# Dev Servers: your processes listening on ports 1024–65535 that are dev tools (node, python, ruby, bun, deno…).
js() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; print -rn -- "\"$s\""; }   # a JSON string
DEV='^(node|python[0-9.]*|Python|ruby|bun|deno|php|java|go|cargo|rails|uvicorn|gunicorn|vite|next-server|hugo|jekyll|dotnet|beam.smp|elixir)$'
list=$(lsof -nP -iTCP -sTCP:LISTEN -u $(id -u) -F pcn 2>/dev/null | awk -v dev="$DEV" '
  /^p/ {pid=substr($0,2)} /^c/ {cmd=substr($0,2)} /^n/ { n=$0; sub(/.*:/,"",n)
    if (n+0 >= 1024 && cmd ~ dev && !seen[n]++) print n "\t" pid "\t" cmd }' | sort -n | head -3)
if [[ $OMNINOTCH_ACTION == stop<1-3> ]]; then
  line=$(print -r -- $list | sed -n "${OMNINOTCH_ACTION#stop}p"); pid=$(print -r -- $line | cut -f2)
  [[ -n $pid ]] && kill -TERM $pid 2>/dev/null; sleep 0.5
  exec "$0"                                                     # show what's left
fi
out=(); i=0
while IFS=$'\t' read port pid cmd; do
  [[ -z $port ]] && continue; i=$(( i + 1 ))
  dir=$(lsof -a -p $pid -d cwd -Fn 2>/dev/null | sed -n 's/^n//p'); dir=${dir:t}
  out+=("{\"v\":1,\"id\":\"port-$port\",\"title\":\"localhost:$port\",\"subtitle\":$(js "$cmd${dir:+ · $dir}"),\"icon\":\"sf:server.rack\",\"priority\":\"low\",\"tint\":\"live\",\"expires\":\"3m\",\"actions\":[{\"title\":\"Open\",\"url\":\"http://localhost:$port\"},{\"title\":\"Stop\",\"run\":\"stop$i\",\"confirm\":true}]}")
done <<< "$list"
print -r -- "[${(j:,:)out}]"
