{
  "v": 2,
  "id": "com.mactoro.shopping",
  "name": "Shopping",
  "description": "Search the big stores and compare.",
  "category": "Web search",
  "author": "Mactoro",
  "icon": "sf:bag",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-amazon",
      "title": "Search Amazon",
      "mode": "run",
      "url": "https://www.amazon.com/s?k={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-ebay",
      "title": "Search eBay",
      "mode": "run",
      "url": "https://www.ebay.com/sch/i.html?_nkw={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-etsy",
      "title": "Search Etsy",
      "mode": "run",
      "url": "https://www.etsy.com/search?q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-google-shopping",
      "title": "Search Google Shopping",
      "mode": "run",
      "url": "https://www.google.com/search?tbm=shop&q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-aliexpress",
      "title": "Search AliExpress",
      "mode": "run",
      "url": "https://www.aliexpress.com/wholesale?SearchText={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-best-buy",
      "title": "Search Best Buy",
      "mode": "run",
      "url": "https://www.bestbuy.com/site/searchpage.jsp?st={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-ikea",
      "title": "Search IKEA",
      "mode": "run",
      "url": "https://www.ikea.com/us/en/search/?q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-the-app-store",
      "title": "Search the App Store",
      "mode": "run",
      "url": "macappstore://search.itunes.apple.com/WebObjects/MZSearch.woa/wa/search?q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-steam",
      "title": "Search Steam",
      "mode": "run",
      "url": "https://store.steampowered.com/search/?term={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "track-a-parcel",
      "title": "Track a Parcel",
      "mode": "run",
      "url": "https://parcelsapp.com/en/tracking/{query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "…",
          "required": true,
          "percentEncoded": true
        }
      ]
    }
  ]
}
