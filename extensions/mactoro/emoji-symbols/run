function run() {
  const ALIAS = { "red heart": "heavy black heart", lol: "tears of joy", laugh: "tears of joy", "100": "hundred points", party: "party popper",
    think: "thinking face", cry: "crying", ok: "ok hand", love: "heart", happy: "smiling face", sad: "frowning", star: "star", tick: "check mark" }
  const isEmoji = env("OMNINOTCH_COMMAND") === "emoji", raw = env("OMNINOTCH_QUERY").toLowerCase().trim()
  const words = (ALIAS[raw] || raw).split(/\s+/).filter(Boolean).map((w) => w.length > 4 ? w.slice(0, -1) : w)   // "smile" finds "smiling"
  const data = (isEmoji ? EMOJI : SYMBOLS).filter(([, n]) => words.every((w) => n.toLowerCase().includes(w)))
  const items = data.slice(0, 300).map(([ch, name]) => ({ id: ch, title: `${ch}  ${name}`, keywords: [name.toLowerCase()],
    actions: [{ title: "Paste", paste: ch }, { title: "Copy", copy: ch }, { title: "Copy Code Point", copy: "U+" + ch.codePointAt(0).toString(16).toUpperCase().padStart(4, "0") }] }))
  return out({ view: "list", title: isEmoji ? "Emoji" : "Symbols", placeholder: isEmoji ? "Search emoji…" : "Search symbols…", filter: "script", sections: [{ items }],
    empty: { title: "Nothing by that name" } })
}
