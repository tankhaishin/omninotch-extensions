#!/usr/bin/osascript -l JavaScript
// Reminders: an OmniNotch extension (FORMATS.md v2). The command bar runs this with OMNINOTCH_COMMAND set and draws the
// screen it prints. Plain JavaScript for Automation: nothing to install.
ObjC.import("Foundation"); ObjC.import("AppKit")
const ENV = $.NSProcessInfo.processInfo.environment
const env = (k) => { const v = ENV.objectForKey(k); return v.isNil() ? "" : v.js }
const SA = Application.currentApplication(); SA.includeStandardAdditions = true
const sh = (cmd) => { try { return SA.doShellScript("export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; " + cmd).replace(/\r/g, "\n") } catch (e) { return null } }
const q = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'"
const out = (o) => JSON.stringify(o)
const home = env("HOME")
const tilde = (p) => p.startsWith(home) ? "~" + p.slice(home.length) : p
function run() {
  if (!env("OMNINOTCH_COMMAND")) {                     // a Live run: the notch status comes from ./live
    const here = $.NSFileManager.defaultManager.currentDirectoryPath.js
    return sh(`cd ${q(here)} && ./live`) || "[]"
  }
  const R = Application("Reminders"), cmd = env("OMNINOTCH_COMMAND"), act = env("OMNINOTCH_ACTION")
  if (act === "done") { R.reminders.byId(env("OMNINOTCH_ITEM")).completed = true }
  if (act === "add") {
    const f = JSON.parse(env("OMNINOTCH_FORM") || "{}"), props = { name: f.title }
    if (f.due) props.dueDate = new Date(f.due)
    if (f.notes) props.body = f.notes
    const list = f.list ? R.lists.byName(f.list) : R.defaultList()
    list.reminders.push(R.Reminder(props))
    return out({ toast: "Reminder added", close: true })
  }
  if (cmd === "new") return out({ view: "form", title: "New reminder", fields: [
      { id: "title", type: "text", title: "Reminder", required: true },
      { id: "list", type: "dropdown", title: "List", options: R.lists.name() },
      { id: "due", type: "date", title: "Due" }, { id: "notes", type: "textarea", title: "Notes" }],
    submit: { title: "Add Reminder", run: "add" } })
  const end = new Date(); end.setHours(23, 59, 59)
  const open = R.reminders.whose({ completed: false })
  const names = open.name(), ids = open.id(), dues = open.dueDate(), lists = open.container.name ? open.container.name() : names.map(() => "")
  const rows = names.map((n, i) => ({ n, id: ids[i], due: dues[i], list: lists[i] }))
  const item = (r) => ({ id: r.id, title: r.n, subtitle: r.list, icon: r.due && r.due < new Date() ? "sf:exclamationmark.circle" : "sf:circle",
    accessory: r.due ? r.due.toLocaleString([], { weekday: "short", hour: "2-digit", minute: "2-digit" }) : "",
    actions: [{ title: "Mark Done", run: "done" }, { title: "Copy", copy: r.n }] })
  const due = rows.filter((r) => r.due && r.due <= end).sort((a, b) => a.due - b.due).map(item)
  const later = rows.filter((r) => !r.due || r.due > end).slice(0, 150).map(item)
  return out({ view: "list", title: "Reminders", placeholder: "Filter reminders…", filter: "local",
    sections: [{ title: "Today and overdue", items: due }, { title: "Not done", items: later }].filter((s) => s.items.length),
    empty: { title: "All done", subtitle: "Nothing left to do" } })
}
