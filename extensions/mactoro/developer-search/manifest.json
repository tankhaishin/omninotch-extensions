{
  "v": 2,
  "id": "com.mactoro.developer-search",
  "name": "Developer Search",
  "description": "Docs, packages and code, one search away.",
  "category": "Developer",
  "author": "Mactoro",
  "icon": "sf:chevron.left.forwardslash.chevron.right",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-github",
      "title": "Search GitHub",
      "mode": "run",
      "url": "https://github.com/search?q={query}&type=repositories",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
