#!/bin/zsh
# Unpushed Work: git repos up to two folders deep. Waits quietly in Live; from your reminder time it rises.
js() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; print -rn -- "\"$s\""; }   # a JSON string
root=${OMNINOTCH_SETTING_FOLDER:-~/Developer}; root=${root/#\~/$HOME}
[[ -d $root ]] || { print -u2 "No folder at $root"; exit 1 }
names=()
for g in $root/*/.git(N/) $root/*/*/.git(N/); do
  r=${g:h}
  if [[ -n $(git -C $r status --porcelain 2>/dev/null | head -1) ]] || \
     [[ -n $(git -C $r log --oneline @{u}.. 2>/dev/null | head -1) ]]; then names+=(${r:t}); fi
done
(( ${#names} == 0 )) && { print -r -- '[]'; exit 0 }
sub=$(js "${(j:, :)names[1,3]}${names[4]:+ …}")
if [[ $(date +%H:%M) > ${OMNINOTCH_SETTING_REMIND:-18:00} ]] && (( $(date +%u) <= 5 )); then
  print -r -- "[{\"v\":1,\"id\":\"git\",\"title\":\"Push before you go\",\"subtitle\":$sub,\"value\":\"${#names}\",\"icon\":\"sf:arrow.up.circle\",\"tint\":\"rising\",\"expires\":\"20m\"}]"
else
  print -r -- "[{\"v\":1,\"id\":\"git\",\"title\":\"Unpushed work\",\"subtitle\":$sub,\"value\":\"${#names}\",\"icon\":\"sf:arrow.up.circle\",\"priority\":\"low\",\"expires\":\"20m\"}]"
fi
