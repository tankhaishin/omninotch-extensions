#!/usr/bin/osascript -l JavaScript
// System Settings: an OmniNotch extension (FORMATS.md v2). The command bar runs this with OMNINOTCH_COMMAND set and draws the
// screen it prints. Plain JavaScript for Automation: nothing to install.
ObjC.import("Foundation"); ObjC.import("AppKit")
const ENV = $.NSProcessInfo.processInfo.environment
const env = (k) => { const v = ENV.objectForKey(k); return v.isNil() ? "" : v.js }
const SA = Application.currentApplication(); SA.includeStandardAdditions = true
const sh = (cmd) => { try { return SA.doShellScript("export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; " + cmd).replace(/\r/g, "\n") } catch (e) { return null } }
const q = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'"
const out = (o) => JSON.stringify(o)
const home = env("HOME")
const tilde = (p) => p.startsWith(home) ? "~" + p.slice(home.length) : p
const PANES = [["Wi-Fi", "com.apple.wifi-settings-extension", "wifi"], ["Bluetooth", "com.apple.BluetoothSettings", "dot.radiowaves.left.and.right"], ["Network", "com.apple.Network-Settings.extension", "network"], ["VPN", "com.apple.NetworkExtensionSettingsUI.NESettingsUIExtension", "lock.shield"], ["Battery", "com.apple.Battery-Settings.extension", "battery.100"], ["Apple Account", "com.apple.systempreferences.AppleIDSettings", "person.crop.circle"], ["Family", "com.apple.Family-Settings.extension", "person.3"], ["Notifications", "com.apple.Notifications-Settings.extension", "bell.badge"], ["Sound", "com.apple.Sound-Settings.extension", "speaker.wave.2"], ["Focus", "com.apple.Focus-Settings.extension", "moon"], ["Screen Time", "com.apple.Screen-Time-Settings.extension", "hourglass"], ["About This Mac", "com.apple.SystemProfiler.AboutExtension", "info.circle"], ["Software Update", "com.apple.Software-Update-Settings.extension", "arrow.down.circle"], ["Storage", "com.apple.settings.Storage", "internaldrive"], ["AirDrop & Handoff", "com.apple.AirDrop-Handoff-Settings.extension", "airplayaudio"], ["Login Items & Extensions", "com.apple.LoginItems-Settings.extension", "list.bullet.rectangle"], ["Language & Region", "com.apple.Localization-Settings.extension", "globe"], ["Date & Time", "com.apple.Date-Time-Settings.extension", "clock"], ["Sharing", "com.apple.Sharing-Settings.extension", "square.and.arrow.up"], ["Time Machine", "com.apple.Time-Machine-Settings.extension", "clock.arrow.circlepath"], ["Transfer or Reset", "com.apple.Transfer-Reset-Settings.extension", "arrow.counterclockwise"], ["Startup Disk", "com.apple.Startup-Disk-Settings.extension", "externaldrive"], ["Device Management", "com.apple.Profiles-Settings.extension", "gearshape.2"], ["Appearance", "com.apple.Appearance-Settings.extension", "circle.lefthalf.filled"], ["Accessibility", "com.apple.Accessibility-Settings.extension", "accessibility"], ["Control Center", "com.apple.ControlCenter-Settings.extension", "switch.2"], ["Siri", "com.apple.Siri-Settings.extension", "waveform"], ["Spotlight", "com.apple.Spotlight-Settings.extension", "magnifyingglass"], ["Privacy & Security", "com.apple.settings.PrivacySecurity.extension", "hand.raised"], ["Desktop & Dock", "com.apple.Desktop-Settings.extension", "dock.rectangle"], ["Displays", "com.apple.Displays-Settings.extension", "display"], ["Wallpaper", "com.apple.Wallpaper-Settings.extension", "photo"], ["Screen Saver", "com.apple.ScreenSaver-Settings.extension", "sparkles.tv"], ["Lock Screen", "com.apple.Lock-Screen-Settings.extension", "lock"], ["Touch ID & Password", "com.apple.Touch-ID-Settings.extension", "touchid"], ["Users & Groups", "com.apple.Users-Groups-Settings.extension", "person.2"], ["Internet Accounts", "com.apple.Internet-Accounts-Settings.extension", "at"], ["Game Center", "com.apple.Game-Center-Settings.extension", "gamecontroller"], ["Wallet & Apple Pay", "com.apple.WalletSettingsExtension", "wallet.pass"], ["Keyboard", "com.apple.Keyboard-Settings.extension", "keyboard"], ["Mouse", "com.apple.Mouse-Settings.extension", "computermouse"], ["Trackpad", "com.apple.Trackpad-Settings.extension", "rectangle.and.hand.point.up.left"], ["Game Controllers", "com.apple.Game-Controller-Settings.extension", "gamecontroller.fill"], ["Printers & Scanners", "com.apple.Print-Scan-Settings.extension", "printer"]]
const PRIVACY = [["Accessibility", "Privacy_Accessibility"], ["Full Disk Access", "Privacy_AllFiles"], ["Screen & System Audio Recording", "Privacy_ScreenCapture"], ["Camera", "Privacy_Camera"], ["Microphone", "Privacy_Microphone"], ["Location Services", "Privacy_LocationServices"], ["Automation", "Privacy_Automation"], ["Files & Folders", "Privacy_FilesAndFolders"], ["Input Monitoring", "Privacy_ListenEvent"], ["Bluetooth", "Privacy_Bluetooth"]]
function run() {
  const panes = PANES.map(([title, id, icon]) => ({ id, title, icon: "sf:" + icon,
    actions: [{ title: "Open", url: "x-apple.systempreferences:" + id }, { title: "Copy Link", copy: "x-apple.systempreferences:" + id }] }))
  const privacy = PRIVACY.map(([title, anchor]) => ({ id: anchor, title, subtitle: "Privacy & Security", icon: "sf:hand.raised", keywords: ["privacy", "permission"],
    actions: [{ title: "Open", url: "x-apple.systempreferences:com.apple.preference.security?" + anchor }] }))
  return out({ view: "list", title: "System Settings", placeholder: "Find a setting…", filter: "local",
    sections: [{ title: "Settings", items: panes }, { title: "Privacy", items: privacy }] })
}
