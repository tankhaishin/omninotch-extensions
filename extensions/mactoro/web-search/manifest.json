{
  "v": 2,
  "id": "com.mactoro.web-search",
  "name": "Web Search",
  "description": "Search the web's big search engines and references.",
  "category": "Web search",
  "author": "Mactoro",
  "icon": "sf:magnifyingglass",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-google",
      "title": "Search Google",
      "mode": "run",
      "url": "https://www.google.com/search?q={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
    {
      "id": "search-duckduckgo",
