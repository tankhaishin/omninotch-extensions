{
  "v": 1,
  "id": "com.mactoro.sunset",
  "name": "Sunset",
  "description": "Sunset coming up, no location needed.",
  "about": "Sunset (and sunrise) coming up, worked out for where your Mac's time zone is. No location access needed.",
  "category": "Time",
  "author": "Mactoro",
  "run": "run",
  "every": "5m",
  "network": false,
  "on": false,
  "settings": [
    {
      "key": "location",
      "title": "Lat, long (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "minutes",
      "title": "Show from (minutes before)",
      "type": "text",
      "default": "60"
    }
  ],
  "example": {
    "title": "Sunset in 42 min",
    "subtitle": "Sunset at 19:02",
    "value": "42m",
    "icon": "sf:sunset.fill",
    "tint": "rising"
  }
}
