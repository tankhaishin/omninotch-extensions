{
  "v": 2,
  "id": "com.mactoro.video-music",
  "name": "Video & Music",
  "description": "Find something to watch or listen to.",
  "category": "Media",
  "author": "Mactoro",
  "icon": "sf:play.rectangle",
  "network": true,
  "kind": "quicklinks",
  "commands": [
    {
      "id": "search-youtube",
      "title": "Search YouTube",
      "mode": "run",
      "url": "https://www.youtube.com/results?search_query={query}",
      "arguments": [
        {
          "name": "query",
          "placeholder": "Search…",
          "required": true,
          "percentEncoded": true
        }
      ]
    },
