#!/usr/bin/env python3
"""Import Raycast's MIT-licensed script commands (github.com/raycast/script-commands) as OmniNotch extensions.

    tools/import-script-commands <path to a checkout of raycast/script-commands>

Never runs the scripts: everything here is read from the files. For each script it writes
extensions/script-commands/<slug>/ with the script unchanged and a v2 manifest (FORMATS.md) that credits the script's
own author and links to its source at the pinned commit. Skipped: files under another licence, files without
Raycast metadata, and anything that isn't macOS. Logos and other images are not copied (they are other companies'
marks, not covered by the MIT licence). Prints a summary of what was imported, skipped, and what scripts need.
"""
import json, os, re, shutil, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEST = os.path.join(ROOT, "extensions", "script-commands")
SCRIPT_EXT = (".sh", ".bash", ".zsh", ".py", ".rb", ".js", ".swift", ".applescript", ".scpt", ".php", ".pl", ".ts")

CATEGORY = {  # their top folder → the store's category
    "ai": "AI", "apps": "Apps", "browsing": "Browsing", "communication": "Communication",
    "conversions": "Conversions", "culture": "Fun", "dashboard": "Dashboard", "dashboards": "Dashboard",
    "developer-utils": "Developer", "home": "Home", "images": "Images", "math": "Math", "media": "Media",
    "navigation": "Navigation", "productivity": "Productivity", "remote-control": "Remote control",
    "system": "System", "web-searches": "Web search",
}
BUILT_IN = {"safari", "notes", "mail", "find-my", "dictionary", "stickies", "music", "messages", "photos", "finder",
            "calendar", "reminders", "terminal", "preview", "quicktime", "system-preferences", "system-settings",
            "shortcuts", "maps", "facetime", "app-store", "books", "podcasts", "tv", "contacts", "keynote", "pages",
            "numbers", "xcode-not", "activity-monitor", "screenshot", "voice-memos", "weather", "clock", "home"}
APP_NAMES = {"cleanshot": "CleanShot X", "iterm": "iTerm", "devutils": "DevUtils", "noteplan3": "NotePlan 3",
             "deepl": "DeepL", "goodlinks": "GoodLinks", "menubarx": "MenubarX", "hazeover": "HazeOver",
             "meetingbar": "MeetingBar", "phpstorm": "PhpStorm", "webstorm": "WebStorm", "openvpn": "OpenVPN",
             "expressvpn": "ExpressVPN", "y-pomodoro": "Y Pomodoro", "dnd-me": "DND Me", "translate-shell": "translate-shell"}
BUILT_IN_NAMES = {"Finder", "System Events", "Safari", "Music", "Mail", "Notes", "Messages", "Reminders", "Calendar",
                  "Terminal", "Photos", "Preview", "QuickTime Player", "System Preferences", "System Settings",
                  "Shortcuts", "Maps", "FaceTime", "Contacts", "Dictionary", "Stickies", "Script Editor", "Books",
                  "Podcasts", "TV", "App Store", "Activity Monitor", "Console", "Screenshot", "Font Book", "Home",
                  "Weather", "Clock", "News", "Stocks", "Find My", "Voice Memos", "Image Capture", "Keychain Access",
                  "Disk Utility", "Automator", "TextEdit", "Calculator", "Chess", "Siri", "Control Center",
                  "Notification Center", "Dock", "SystemUIServer", "Spotlight", "Image Events", "Bluetooth File Exchange"}
SKIP_APPS = {"raycast"}                     # scripts that drive Raycast itself mean nothing in OmniNotch
MODE = {"fullOutput": "view", "compact": "run", "silent": "run", "inline": "live"}
STOCK = {"bash", "sh", "zsh", "osascript", "perl", "swift-not", "env"}
NEEDS_INTERP = {"python3": "Python 3 (Xcode Command Line Tools)", "python": "Python", "swift": "Xcode Command Line Tools",
                "node": "Node.js", "ruby": "Ruby", "php": "PHP", "deno": "Deno", "bun": "Bun", "ts-node": "Node.js"}
OTHER_LICENCE = re.compile(r"GNU General Public|GPL-[0-9]|Apache License|Mozilla Public|All rights reserved", re.I)
SECRET = re.compile(r"""(API_?KEY|TOKEN|SECRET|PASSWORD|CLIENT_ID)\s*=\s*["']?(["']|<|YOUR|your|xxx|$)""", re.M)
RISKY = re.compile(r"\b(rm\s+-rf|sudo\s|shutdown|reboot|killall|kill\s+-9|defaults\s+write|diskutil\s+erase|pmset\s)")
NETWORK = re.compile(r"\b(curl\s|wget\s|URLSession|requests\.(get|post)|urllib|fetch\(|http\.get|Net::HTTP|NSURL)")
DEP_LINE = re.compile(r"(?:Dependenc(?:y|ies)|Requires?|Install(?:ation)?)\s*:?\s*(.*)", re.I)
BREW = re.compile(r"brew install (?:--cask )?([a-z0-9@._+-]+)")


def meta(text):
    m = {}
    for k, v in re.findall(r"@raycast\.([A-Za-z0-9]+)\s+(.*)", text):
        m.setdefault(k[0].lower() + k[1:] if k != "packagename" else "packageName", v.strip())
    return m


def slug(s):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-")


def needs_of(path, text, top, sub):
    needs = []
    first = text.splitlines()[0] if text else ""
    interp = os.path.basename(first.split()[-1]) if first.startswith("#!") else ""
    if first.startswith("#!") and "env" in first: interp = first.split()[-1]
    if interp in NEEDS_INTERP: needs.append(NEEDS_INTERP[interp])
    header = "\n".join(l for l in text.splitlines()[:40] if l.lstrip().startswith(("#", "//", "--")))
    for b in BREW.findall(header): needs.append(b)
    for line in DEP_LINE.findall(header):
        for tool in re.findall(r"`([a-zA-Z0-9._@+-]+)`", line):
            if tool not in needs and len(tool) < 30: needs.append(tool)
    if top == "apps" and sub and sub not in BUILT_IN:
        needs.append(APP_NAMES.get(sub, sub.replace("-", " ").title()) + " app")
    for app in re.findall(r'(?:tell application|open -a|application id of|tell app)\s+"([^"]+)"', text) + \
               re.findall(r'open -a\s+([A-Z][A-Za-z0-9.]+)', text):
        app = app.removesuffix(".app")
        if app not in BUILT_IN_NAMES and not app.startswith("com.") and f"{app} app" not in needs: needs.append(f"{app} app")
    if SECRET.search(text): needs.append("Your API key or account (edit the script)")
    return list(dict.fromkeys(needs))


def main(src):
    commit = subprocess.run(["git", "-C", src, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    if os.path.isdir(DEST): shutil.rmtree(DEST)
    os.makedirs(DEST)
    shutil.copy(os.path.join(src, "LICENSE"), os.path.join(DEST, "LICENSE"))
    done, skipped, seen = [], {}, set()
    base = os.path.join(src, "commands")
    for dirpath, _, files in os.walk(base):
        rel = os.path.relpath(dirpath, base)
        parts = [] if rel == "." else rel.split(os.sep)
        if any(p.startswith(("_", ".")) or p in ("images", "templates") for p in parts): continue
        for f in sorted(files):
            if not f.endswith(SCRIPT_EXT) and "." in f: continue
            path = os.path.join(dirpath, f)
            try: text = open(path, encoding="utf-8").read()
            except Exception: skipped["not text"] = skipped.get("not text", 0) + 1; continue
            m = meta(text)
            if "title" not in m or "mode" not in m: skipped["no Raycast metadata"] = skipped.get("no Raycast metadata", 0) + 1; continue
            if OTHER_LICENCE.search(text): skipped["another licence"] = skipped.get("another licence", 0) + 1; continue
            if m.get("platform") and "macos" not in m["platform"].lower(): skipped["not macOS"] = skipped.get("not macOS", 0) + 1; continue
            if m["mode"] not in MODE: skipped[f"mode {m['mode']}"] = skipped.get(f"mode {m['mode']}", 0) + 1; continue
            top = parts[0] if parts else "other"
            sub = parts[1] if len(parts) > 1 else ""
            if sub in SKIP_APPS or "raycast://" in text: skipped["drives Raycast itself"] = skipped.get("drives Raycast itself", 0) + 1; continue
            name = slug(f"{sub}-{os.path.splitext(f)[0]}" if sub and not os.path.splitext(f)[0].startswith(sub) else os.path.splitext(f)[0])[:41].strip("-")
            n, i = name, 2
            while n in seen: n = f"{name[:38]}-{i}"; i += 1
            seen.add(n)
            args = []
            for k in ("argument1", "argument2", "argument3"):
                if k in m:
                    try: a = json.loads(m[k])
                    except Exception: continue
                    args.append({"name": f"arg{len(args) + 1}", "placeholder": a.get("placeholder", ""),
                                 "required": not a.get("optional", False), "percentEncoded": bool(a.get("percentEncoded"))})
            mode = MODE[m["mode"]]
            command = {"id": "main", "title": m["title"], "subtitle": m.get("packageName", ""), "mode": mode}
            if args: command["arguments"] = args
            if m.get("needsConfirmation", "").lower() == "true" or RISKY.search(text): command["confirm"] = True
            manifest = {
                "v": 2, "id": f"script-commands.{n}", "name": m["title"][:40],
                "description": (m.get("description") or m.get("packageName") or m["title"])[:90],
                "category": CATEGORY.get(top, "Other"), "author": m.get("author", "a Script Commands contributor"),
                "authorURL": m.get("authorURL", ""), "format": "raycast-script", "script": f,
                "source": f"https://github.com/raycast/script-commands/blob/{commit}/commands/{rel}/{f}".replace("/./", "/"),
                "license": "MIT", "network": bool(NETWORK.search("\n".join(l for l in text.splitlines() if "@raycast." not in l))), "needs": needs_of(path, text, top, sub),
                "commands": [command],
            }
            manifest["updated"] = subprocess.run(["git", "-C", src, "log", "-1", "--format=%cs", "--", os.path.relpath(path, src)],
                                                 capture_output=True, text=True).stdout.strip() or None
            if mode == "live" and m.get("refreshTime"): manifest["every"] = m["refreshTime"].replace(" ", "")
            if m.get("currentDirectoryPath"): manifest["cwd"] = m["currentDirectoryPath"]
            d = os.path.join(DEST, n); os.makedirs(d)
            shutil.copy(path, os.path.join(d, f)); os.chmod(os.path.join(d, f), 0o755)
            json.dump(manifest, open(os.path.join(d, "manifest.json"), "w"), indent=2, ensure_ascii=False)
            done.append(manifest)
    ready = [x for x in done if not x["needs"]]
    print(f"imported {len(done)} from raycast/script-commands@{commit[:7]}; {len(ready)} need nothing extra")
    print("skipped:", ", ".join(f"{v} {k}" for k, v in sorted(skipped.items(), key=lambda kv: -kv[1])))
    by_cat = {}
    for x in done: by_cat[x["category"]] = by_cat.get(x["category"], 0) + 1
    print("categories:", ", ".join(f"{k} {v}" for k, v in sorted(by_cat.items(), key=lambda kv: -kv[1])))
    modes = {}
    for x in done: modes[x["commands"][0]["mode"]] = modes.get(x["commands"][0]["mode"], 0) + 1
    print("modes:", modes)
    needs = {}
    for x in done:
        for nd in x["needs"]: needs[nd] = needs.get(nd, 0) + 1
    print("top needs:", ", ".join(f"{k} {v}" for k, v in sorted(needs.items(), key=lambda kv: -kv[1])[:15]))


if __name__ == "__main__":
    main(sys.argv[1])
