#!/usr/bin/env python3
"""Run OmniNotch extensions the way the app does and check what they print (EXTENSIONS.md, format v1).

    tools/check-extension <folder> [<folder>…] [--action <name>] [--set KEY=value …]

Exit 0 when every extension passes. Used for our own extensions and to review community submissions.
"""
import json, os, re, subprocess, sys, tempfile, time

TINTS = {"calm", "live", "rising", "alert"}
STATES = {"active", "needsYou", "done", "failed"}
PRIORITIES = {"low", "normal", "high"}
DURATION = re.compile(r"^\d+(\.\d+)?[smhd]$")


def symbols_exist(names):
    """Which SF Symbol names macOS has (one swift call for all of them)."""
    if not names:
        return set()
    code = "import AppKit\nfor n in CommandLine.arguments.dropFirst() where NSImage(systemSymbolName: n, accessibilityDescription: nil) != nil { print(n) }"
    with tempfile.NamedTemporaryFile("w", suffix=".swift", delete=False) as f:
        f.write(code)
    out = subprocess.run(["swift", f.name, *names], capture_output=True, text=True).stdout
    os.unlink(f.name)
    return set(out.split())


def check_activity(a, actions, problems, warnings, icons):
    if a.get("v") != 1: problems.append('"v" must be 1')
    i = a.get("id")
    if not isinstance(i, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", i): problems.append(f"bad id {i!r}")
    if a.get("end") is True: return
    if not isinstance(a.get("title"), str) or not a["title"].strip(): problems.append(f"{i}: title is required")
    for field, n in (("title", 40), ("subtitle", 60), ("value", 8)):
        v = a.get(field)
        if v is not None and not isinstance(v, str): problems.append(f"{i}: {field} must be text")
        elif v and len(v) > n: warnings.append(f"{i}: {field} {v!r} is cut to {n} characters")
    p = a.get("progress")
    if p is not None and p != "indeterminate" and not (isinstance(p, (int, float)) and 0 <= p <= 1):
        problems.append(f"{i}: progress must be 0…1 or \"indeterminate\"")
    for field, allowed in (("tint", TINTS), ("state", STATES), ("priority", PRIORITIES)):
        if field in a and a[field] not in allowed: problems.append(f"{i}: {field} {a[field]!r} isn't one of {sorted(allowed)}")
    if a.get("tint") == "alert" and a.get("state") not in ("failed", None) and a.get("priority") != "high":
        warnings.append(f"{i}: alert (red) is for something broken")
    icon = a.get("icon")
    if isinstance(icon, str) and icon.startswith("sf:"): icons.add(icon[3:])
    e = a.get("expires")
    if e is not None and not (isinstance(e, str) and (DURATION.match(e) or re.match(r"^\d{4}-\d\d-\d\dT", e))):
        problems.append(f"{i}: expires {e!r} should be like 30s, 10m, 2h, 1d or an ISO date")
    btns = a.get("actions", [])
    if len(btns) > 2: warnings.append(f"{i}: only the first 2 buttons show")
    for b in btns:
        if not b.get("title"): problems.append(f"{i}: a button needs a title")
        if "run" in b and b["run"] not in actions: problems.append(f"{i}: button runs {b['run']!r}, not in the manifest's actions")
        if "url" in b and not str(b["url"]).startswith(("https://", "http://")): problems.append(f"{i}: button url must be http(s)")
        if "run" not in b and "url" not in b: problems.append(f"{i}: a button needs run or url")


CATEGORIES = ("Mac", "Time", "Work", "Developer", "AI", "Apps", "Browsing", "Communication", "Conversions", "Dashboard",
              "Fun", "Home", "Images", "Math", "Media", "Navigation", "Productivity", "Remote control", "System", "Web search")
MODES = ("view", "run", "live")


def check_v2(folder, m, problems, warnings, icons):
    """FORMATS.md v2: commands (and quicklinks, and Raycast-format scripts), checked from the files alone."""
    cmds = m.get("commands") or []
    if not cmds: problems.append("v2: commands is required")
    seen = set()
    for c in cmds:
        cid = c.get("id", "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,60}", cid): problems.append(f"command id {cid!r}: lowercase letters, digits and -")
        if cid in seen: problems.append(f"command id {cid!r} is used twice")
        seen.add(cid)
        if not c.get("title"): problems.append(f"command {cid}: title is required")
        if c.get("mode") not in MODES: problems.append(f"command {cid}: mode must be one of {MODES}")
        args = c.get("arguments", [])
        if len(args) > 3: problems.append(f"command {cid}: at most 3 arguments")
        url = c.get("url")
        if url is not None:
            if not re.match(r"^[a-z][a-z0-9+.-]*:", url): problems.append(f"command {cid}: url needs a scheme")
            names = set(re.findall(r"\{([a-z0-9_]+)\}", url))
            missing = names - {a.get("name") for a in args}
            if missing: problems.append(f"command {cid}: url uses {sorted(missing)} but has no such argument")
            if url.startswith(("file:", "javascript:")): problems.append(f"command {cid}: {url.split(':')[0]} links aren't allowed")
        icon = c.get("icon") or ""
        if icon.startswith("sf:"): icons.add(icon[3:])
    icon = m.get("icon") or ""
    if icon.startswith("sf:"): icons.add(icon[3:])
    if m.get("format") == "raycast-script":
        script = os.path.join(folder, m.get("script", ""))
        if not os.path.isfile(script): problems.append("raycast-script: the script file is missing")
        elif not os.access(script, os.X_OK): problems.append("raycast-script: the script isn't executable")
        elif "@raycast.title" not in open(script, errors="replace").read(): problems.append("raycast-script: no @raycast.title in the script")
        for k in ("source", "license", "author"):
            if not m.get(k): problems.append(f"raycast-script: {k} is required (credit and licence)")
    elif "run" not in m and any(c.get("mode") != "run" or "url" not in c for c in cmds):
        problems.append("v2: commands without a url need a run script")


OPTS = {"command": None, "args": {}, "automation": False}
ACTION_KINDS = ("url", "open", "reveal", "copy", "paste", "run", "push")
FIELD_TYPES = ("text", "textarea", "dropdown", "checkbox", "date", "number")


def check_actions(where, actions, problems):
    for a in actions or []:
        if not a.get("title"): problems.append(f"{where}: an action needs a title")
        kinds = [k for k in ACTION_KINDS if k in a]
        if len(kinds) != 1: problems.append(f"{where}: action {a.get('title')!r} needs exactly one of {ACTION_KINDS}")
        if "url" in a and not re.match(r"^[a-z][a-z0-9+.-]*:", str(a["url"])): problems.append(f"{where}: url needs a scheme")
        if "push" in a: validate_screen(a["push"], f"{where} → push", problems)


def validate_screen(s, where, problems):
    """COMMANDS.md v2: a screen (list, detail, form) or a result (toast, view, pop, close)."""
    if not isinstance(s, dict): problems.append(f"{where}: output must be one JSON object"); return
    if "view" in s and isinstance(s["view"], dict): return validate_screen(s["view"], where, problems)
    kind = s.get("view")
    if kind is None:
        if not any(k in s for k in ("toast", "pop", "close")): problems.append(f"{where}: expected a screen (view) or a result (toast, pop, close)")
        return
    if kind == "list":
        rows = 0
        for sec in s.get("sections") or [{"items": s.get("items", [])}]:
            for it in sec.get("items", []):
                rows += 1
                if not it.get("title"): problems.append(f"{where}: every row needs a title")
                if "id" not in it: problems.append(f"{where}: row {it.get('title')!r} needs an id")
                check_actions(f"{where}: row {it.get('title')!r}", it.get("actions"), problems)
        if rows > 500: problems.append(f"{where}: at most 500 rows ({rows})")
        if s.get("filter") not in (None, "local", "script"): problems.append(f"{where}: filter is local or script")
        if rows == 0 and not s.get("empty"): problems.append(f"{where}: an empty list needs an empty state")
    elif kind == "detail":
        if not isinstance(s.get("body", ""), str): problems.append(f"{where}: body must be text")
        for md in s.get("metadata", []):
            if "label" not in md or "value" not in md: problems.append(f"{where}: metadata needs label and value")
        check_actions(f"{where}: detail", s.get("actions"), problems)
    elif kind == "form":
        for f in s.get("fields", []):
            if not f.get("id") or f.get("type") not in FIELD_TYPES: problems.append(f"{where}: field {f.get('id')!r} needs an id and a type in {FIELD_TYPES}")
            if f.get("type") == "dropdown" and not f.get("options"): problems.append(f"{where}: dropdown {f.get('id')!r} needs options")
        sub = s.get("submit") or {}
        if not sub.get("title") or not sub.get("run"): problems.append(f"{where}: a form needs submit {{title, run}}")
    else:
        problems.append(f"{where}: view must be list, detail or form")


def run_commands(folder, m, problems, warnings, overrides):
    """Runs each command the way the command bar will and checks the screen it prints. Extensions that control other
    apps (manifest "automation") are compiled, not run, unless --allow-automation: running them asks macOS for
    permission on this Mac."""
    exe = os.path.join(folder, m["run"])
    if not os.access(exe, os.X_OK): problems.append("run isn't executable (chmod +x run)"); return None
    first = open(exe, errors="replace").readline()
    if "JavaScript" in first or "osascript" in first:
        out = tempfile.mktemp(suffix=".scpt")
        lang = ["-l", "JavaScript"] if "JavaScript" in first else []
        r = subprocess.run(["osacompile", *lang, "-o", out, exe], capture_output=True, text=True)
        if r.returncode: problems.append(f"doesn't compile: {r.stderr.strip()[:200]}"); return None
    if m.get("automation") and not OPTS["automation"]:
        warnings.append(f"controls {', '.join(m['automation'])}: compiled, not run (--allow-automation to run)")
        return None
    shown = []
    for c in m.get("commands", []):
        if "url" in c or (OPTS["command"] and c["id"] != OPTS["command"]): continue
        if c.get("mode") == "live": continue
        data = tempfile.mkdtemp(prefix="omn-check-")
        env = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin", "HOME": os.environ["HOME"],
               "LANG": "en_US.UTF-8", "OMNINOTCH_VERSION": "2", "OMNINOTCH_DATA": data, "OMNINOTCH_COMMAND": c["id"],
               "OMNINOTCH_QUERY": OPTS["args"].get("QUERY", "")}
        for s in m.get("settings", []):
            env["OMNINOTCH_SETTING_" + s["key"].upper()] = overrides.get(s["key"].upper(), s.get("default", ""))
        for a in c.get("arguments", []):
            env["OMNINOTCH_ARG_" + a["name"].upper()] = OPTS["args"].get(a["name"].upper(), a.get("placeholder", "test"))
        t0 = time.time()
        try: r = subprocess.run([exe], cwd=folder, env=env, capture_output=True, timeout=10)
        except subprocess.TimeoutExpired: problems.append(f"{c['id']}: took longer than 10 s"); continue
        if time.time() - t0 > 3: warnings.append(f"{c['id']}: took {time.time() - t0:.1f} s")
        if r.returncode: problems.append(f"{c['id']}: exit {r.returncode}: {r.stderr.decode()[:200].strip()}"); continue
        if not r.stdout.strip(): shown.append({"title": f"{c['id']} (quiet success)"}); continue
        try: s = json.loads(r.stdout)
        except Exception: problems.append(f"{c['id']}: output isn't JSON: {r.stdout[:120]!r}"); continue
        validate_screen(s, c["id"], problems)
        rows = sum(len(sec.get("items", [])) for sec in s.get("sections", [])) if s.get("view") == "list" else None
        shown.append({"title": f"{c['id']}: {s.get('view') or 'result'}" + (f" ({rows} rows)" if rows is not None else "")})
    return shown


def check(folder, action=None, overrides=None):
    problems, warnings, icons = [], [], set()
    try:
        m = json.load(open(os.path.join(folder, "manifest.json")))
    except Exception as e:
        return [f"manifest.json: {e}"], [], set(), None
    v2, shown_cmds = m.get("v") == 2, None
    for k in ("v", "id", "name") + (() if v2 else ("run",)):
        if k not in m: problems.append(f"manifest: {k} is required")
    if m.get("v") not in (1, 2): problems.append("manifest: v must be 1 or 2")
    parts = folder.rstrip("/").split("/")
    if len(parts) >= 3 and parts[-3] == "extensions":          # the gallery repo: extensions/<author>/<name>
        author, name = parts[-2], parts[-1]
        want = f"com.mactoro.{name}" if author == "mactoro" else f"{author}.{name}"
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", name): problems.append("folder name: lowercase letters, digits and -")
        if m.get("id") != want: problems.append(f'manifest id must be "{want}" for extensions/{author}/{name}')
        for k in ("description", "category") + (() if v2 else ("example",)):
            if not m.get(k): problems.append(f"manifest: {k} is required in the gallery")
        if m.get("category") and m["category"] not in CATEGORIES:
            problems.append(f"category must be one of: {', '.join(CATEGORIES)}")
        if not v2 and len(m.get("description", "")) > 50: warnings.append("description is cut to one line after about 45 characters")
    elif os.path.basename(folder.rstrip("/")) != m.get("id"): warnings.append("folder name should be the id")
    if v2:
        check_v2(folder, m, problems, warnings, icons)
        if "run" not in m: return problems, warnings, icons, None      # commands only: nothing to run here
        shown_cmds = run_commands(folder, m, problems, warnings, overrides or {})
        if not m.get("every"): return problems, warnings, icons, shown_cmds     # commands only, no Live part
    exe = os.path.join(folder, m.get("run", "run"))
    if not os.access(exe, os.X_OK): return problems + ["run isn't executable (chmod +x run)"], warnings, icons, None
    data = tempfile.mkdtemp(prefix="omn-check-")
    env = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin", "HOME": os.environ["HOME"],
           "LANG": "en_US.UTF-8", "OMNINOTCH_VERSION": "1", "OMNINOTCH_DATA": data}
    for s in m.get("settings", []):
        env["OMNINOTCH_SETTING_" + s["key"].upper()] = (overrides or {}).get(s["key"].upper(), s.get("default", ""))
    if action: env["OMNINOTCH_ACTION"] = action
    t = time.time()
    try:
        r = subprocess.run([exe], cwd=folder, env=env, capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        return problems + ["took longer than 10 s"], warnings, icons, None
    took = time.time() - t
    if took > 3: warnings.append(f"took {took:.1f} s (keep it under a few seconds)")
    if r.returncode != 0: return problems + [f"exit {r.returncode}: {r.stderr.decode()[:300].strip()}"], warnings, icons, None
    if len(r.stdout) > 65536: problems.append("printed more than 64 KB")
    try:
        out = json.loads(r.stdout)
    except Exception:
        return problems + [f"output isn't JSON: {r.stdout[:120]!r}"], warnings, icons, None
    acts = out if isinstance(out, list) else out.get("activities") if isinstance(out, dict) else None
    if acts is None: return problems + ["expected a list, or {activities, next}"], warnings, icons, None
    if isinstance(out, dict) and "next" in out and not DURATION.match(str(out["next"])): problems.append("next should be like 15s")
    if len(acts) > 5: warnings.append("only 5 activities show")
    for a in acts: check_activity(a, m.get("actions", {}) or {}, problems, warnings, icons)
    if m.get("v") == 2 and shown_cmds: acts = acts + shown_cmds                 # Live and commands, both checked
    return problems, warnings, icons, acts


def main():
    args, folders, action, overrides = sys.argv[1:], [], None, {}
    while args:
        a = args.pop(0)
        if a == "--action": action = args.pop(0)
        elif a == "--set": k, v = args.pop(0).split("=", 1); overrides[k.upper()] = v
        elif a == "--command": OPTS["command"] = args.pop(0)
        elif a == "--arg": k, v = args.pop(0).split("=", 1); OPTS["args"][k.upper()] = v
        elif a == "--allow-automation": OPTS["automation"] = True
        else: folders.append(a)
    results, all_icons = [], set()
    for f in folders:
        p, w, icons, acts = check(os.path.abspath(f), action, overrides)
        results.append((f, p, w, icons, acts)); all_icons |= icons
    have = symbols_exist(sorted(all_icons))
    failed = 0
    for f, p, w, icons, acts in results:
        p = p + [f"no SF Symbol named {n!r}" for n in sorted(icons - have)]
        name = os.path.basename(f.rstrip("/"))
        shown = "; ".join(f"{a.get('title')}" + (f" [{a['value']}]" if a.get("value") else "") for a in (acts or [])) or "(nothing)"
        print(f"{'FAIL' if p else 'ok  '} {name}: {shown}")
        for x in p: print(f"     ✗ {x}")
        for x in w: print(f"     · {x}")
        failed += bool(p)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
