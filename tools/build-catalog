#!/usr/bin/env python3
"""Build the store from extensions/<author>/<name>/: <out>/catalog.json and <out>/<author>/<name>.zip.

    tools/build-catalog <out-dir>

The zip holds one folder named by the extension's id. Zips are byte-for-byte reproducible (fixed dates, sorted),
and catalog.json carries each zip's SHA-256 so the app can check what it downloads.
"""
import hashlib, io, json, os, subprocess, sys, zipfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def updated(path):
    out = subprocess.run(["git", "-C", ROOT, "log", "-1", "--format=%cs", "--", path], capture_output=True, text=True).stdout.strip()
    return out or None


def build(out):
    featured = json.load(open(os.path.join(ROOT, "featured.json")))
    items = []
    base = os.path.join(ROOT, "extensions")
    for author in sorted(os.listdir(base)):
        for name in sorted(os.listdir(os.path.join(base, author))):
            folder = os.path.join(base, author, name)
            if not os.path.isdir(folder): continue
            m = json.load(open(os.path.join(folder, "manifest.json")))
            buf = io.BytesIO()
            with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
                for f in sorted(os.listdir(folder)):
                    p = os.path.join(folder, f)
                    if not os.path.isfile(p) or f.startswith("."): continue
                    info = zipfile.ZipInfo(f"{m['id']}/{f}", date_time=(2026, 1, 1, 0, 0, 0))
                    info.external_attr = (0o100755 if os.access(p, os.X_OK) else 0o100644) << 16
                    info.compress_type = zipfile.ZIP_DEFLATED
                    z.writestr(info, open(p, "rb").read())
            data = buf.getvalue()
            os.makedirs(os.path.join(out, author), exist_ok=True)
            open(os.path.join(out, author, f"{name}.zip"), "wb").write(data)
            commands = [{k: c[k] for k in ("id", "title", "mode", "url") if k in c} | ({"arguments": len(c["arguments"])} if c.get("arguments") else {})
                        for c in m.get("commands", [])]
            items.append({
                "author": author, "name": name, "id": m["id"], "title": m["name"], "v": m.get("v", 1),
                "kind": m.get("kind") or ("script" if m.get("format") == "raycast-script" else "extension"),
                "description": m.get("description", ""), "about": m.get("about", m.get("description", "")),
                "category": m.get("category"), "example": m.get("example"), "icon": m.get("icon"),
                "network": bool(m.get("network")), "every": m.get("every", "60s"),
                "settings": [s["title"] for s in m.get("settings", [])],
                "commands": commands, "needs": m.get("needs", []) + [f"Permission to control {a} (macOS asks once)" for a in m.get("automation", [])],
                "by": m.get("author") or author, "byURL": m.get("authorURL", ""), "license": m.get("license", "MIT"),
                "bundled": author == "mactoro" and m.get("v", 1) == 1, "featured": f"{author}/{name}" in featured,
                "updated": m.get("updated") or updated(folder), "sha256": hashlib.sha256(data).hexdigest(), "size": len(data),
                "source": m.get("source") or f"https://github.com/tankhaishin/omninotch-extensions/tree/main/extensions/{author}/{name}",
            })
    json.dump({"v": 1, "extensions": items}, open(os.path.join(out, "catalog.json"), "w"), indent=1)
    n_cmds = sum(max(1, len(x["commands"])) for x in items)
    print(f"{len(items)} extensions, {n_cmds} commands → {out}")


if __name__ == "__main__":
    build(sys.argv[1] if len(sys.argv) > 1 else "dist")
